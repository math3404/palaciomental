# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,django,palaciomental-production.up.railway.app,palaciomental.com.br
CSRF_TRUSTED_ORIGINS=https://palaciomental.com.br,https://palaciomental-production.up.railway.app

# Redis (opcional fora do Docker; no Compose, o host é o nome do serviço)
REDIS_URL=redis://redis:6379/1
CACHE_KEY_PREFIX=pm-dev

# Página pública /status (endpoint completo, incluindo /v1/status)
STATUS_API_URL=https://api.palaciomental.com.br/v1/status
STATUS_API_TIMEOUT=3

# PostgreSQL (usado por Django via DATABASE_URL e por status_api via variáveis individuais)
POSTGRES_DB=local_db
POSTGRES_USER=local_user
POSTGRES_PASSWORD=184122
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Status API (Spring Boot)
# No Docker Compose local, usa o nome do serviço "django"
# No Railway produção, deve apontar para o hostname interno do serviço Django
# Exemplo Railway: http://django-app.railway.internal:8000
DJANGO_APP_URL=http://django:8000
